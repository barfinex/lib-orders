{
  "name": "@barfinex/orders",
  "version": "0.0.0-development",
  "private": false,
  "description": "Orders library for the Barfinex ecosystem. Provides shared order models, services, and utilities for creating, managing, and processing trading orders in a unified way.",
  "author": "Barfinex",
  "license": "MIT",
  "homepage": "https://github.com/barfinex/lib-orders#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barfinex/lib-orders.git"
  },
  "bugs": {
    "url": "https://github.com/barfinex/lib-orders/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.app.json",
    "build:npm": "tsc -p tsconfig.build.json",
    "rebuild": "npm run clean && npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "barfinex",
    "orders",
    "order-management",
    "trading",
    "trade",
    "exchange",
    "market",
    "nestjs",
    "nestjs-module",
    "typescript",
    "models",
    "services",
    "utilities"
  ],
  "dependencies": {
    "@barfinex/types": "latest",
    "@barfinex/utils": "latest",
    "@barfinex/plugin-driver": "latest",
    "@barfinex/connectors": "latest",
    "@barfinex/key": "latest"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "rxjs": "^7.8.1",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "rimraf": "^5.0.5",
    "semantic-release": "^24.1.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@nestjs/common": "^10.0.0",
    "rxjs": "^7.8.1",
    "axios": "^1.7.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}